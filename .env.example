# ==============================================================================
# ShipSpace Docker & Application Environment Configuration Example
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=shipspace_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Backend Service Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_for_production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://localhost

# Frontend Service Configuration
VITE_API_BASE_URL=http://localhost:5000/api
