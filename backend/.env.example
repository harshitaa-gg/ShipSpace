# ShipSpace Backend Server Configuration
PORT=5000

# PostgreSQL Database Configuration
# IMPORTANT: Use shipspace_test_phase5 for testing; do not reset or modify shipspace_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipspace_test_phase5
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# Authentication & JWT Configuration
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (comma-separated list for production)
CORS_ORIGIN=http://localhost:5173
